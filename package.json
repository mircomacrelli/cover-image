{
	"name": "cover-image",
	"version": "1.0.1",
	"description": "Automatically include the image linked in the property cover at the top of the note body",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"image"
	],
	"author": "Mirco Macrelli",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.28.0",
		"obsidian": "latest",
		"process": "0.11.10",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
